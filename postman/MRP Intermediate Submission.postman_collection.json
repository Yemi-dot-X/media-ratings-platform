                  "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Correct media ID\", function () {\r\n    const media = pm.response.json();\r\n    const expectedId = Number(pm.collectionVariables.get(\"mediaId\"));\r\n\r\n    pm.expect(media.id).to.eql(expectedId);\r\n});"
