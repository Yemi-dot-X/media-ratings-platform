@startuml

abstract class Media {
    - id : int
    - title : String
    - description : String
    - releaseYear : int
    - ageRestriction : int
    - genres : Set<Genre>
}

class Movie {
}

class Series {
}

class Game {
}


enum Genre {
    ACTION
    COMEDY
    DRAMA
    HORROR
    THRILLER
    FANTASY
    SCIENCE_FICTION
    ROMANCE
    DOCUMENTARY
}

Media <|-- Movie
Media <|-- Series
Media <|-- Game

Media "1" --> "0..*" Genre : genres

class User {
    - id : int
    - username : String
    - password : String
}

class Rating {
    - id : int
    - score : int
    - comment : String
}

User "1" --> "0..*" Rating : creates
Media "1" --> "0..*" Rating : receives

class MediaService {
- mediaList: List<Media>

+ createMedia(media: Media): void
+ findMediaById(id: int): Media
+ updateMedia(id: int, userId: int, ...): void
+ deleteMedia(id: int, userId: int): void
+ findByGenre(genre: Genre): List<Media>

}

MediaService ..> Media : uses

class UserService {
    + findUserById(id : int) : User
    + getUserRatings(userId : int) : List<Rating>
}

class RatingService {
    + createRating(rating : Rating) : void
    + findByUser(userId : int) : List<Rating>
    + findByMedia(mediaId : int) : List<Rating>
}

class MediaService {
    + createMedia(media : Media) : void
    + findMediaById(id : int) : Media
    + findByGenre(genre : Genre) : List<Media>
}

UserService ..> RatingService : uses
MediaService ..> RatingService : uses

@enduml